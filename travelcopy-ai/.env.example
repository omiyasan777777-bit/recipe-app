# Ollama 設定（ローカルAIモデルを使用する場合）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3

# OpenAI 設定（別途 OpenAI API を使用する場合）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI生成設定
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Playwright 設定
HEADLESS_MODE=true
WAIT_UNTIL=networkidle
PAGE_TIMEOUT=60000

# デバッグモード
DEBUG=false

# 出力ディレクトリ
OUTPUT_DIR=./output
